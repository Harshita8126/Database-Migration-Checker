# =============================================================================
# PostgreSQL Migration Safety Checker - Streamlit Secrets Template
# Copy this file to .streamlit/secrets.toml and fill in your values.
# =============================================================================

# JWT Security
# Generate a secure key in terminal with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY = "replace_with_a_secure_random_64_char_hex_key"
ACCESS_TOKEN_EXPIRE_MINUTES = "15"
REFRESH_TOKEN_EXPIRE_DAYS = "7"

# Feature Flags
REQUIRE_EMAIL_VERIFICATION = "false"
USE_OTP_FOR_RESET = "false"

# SMTP Email Configuration (Optional - If left blank, dev mode logs emails to console)
SMTP_HOST = "smtp.gmail.com"
SMTP_PORT = "587"
SMTP_USER = "your-email@gmail.com"
SMTP_PASSWORD = "your-app-password"
SMTP_FROM_EMAIL = "no-reply@pgsafetymigrations.internal"
SMTP_FROM_NAME = "PostgreSQL Migration Safety Checker"
SMTP_USE_TLS = "true"
